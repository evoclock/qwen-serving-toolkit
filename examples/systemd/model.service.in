[Unit]
Description=Qwen-compatible model service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/path/to/your/serve-command
Restart=no
TimeoutStartSec=1800
TimeoutStopSec=180

# Keep this unit on-demand unless you explicitly want it at login.
# Do not put credentials or host-specific tunnel addresses in this template.
