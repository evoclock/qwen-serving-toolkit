+static json reasoning_budget_to_json(const common_reasoning_budget_info & info) {
+    return json {
+        {"enabled",                info.enabled},
+        {"budget_tokens",          info.budget},
+        {"counted_tokens",         info.counted_tokens},
+        {"reasoning_tokens",       info.generated_tokens},
+        {"remaining_tokens",       info.remaining_tokens},
+        {"termination",            common_reasoning_budget_end_reason_name(info.end_reason)},
+        {"end_sequence_emitted",   info.end_sequence_emitted},
+        {"end_match",               info.end_match},
+        {"end_tag",                info.end_tag.empty() ? json(nullptr) : json(info.end_tag)},
+    };
+}
+
+static std::string trace_filename_component(const std::string & value, const std::string & fallback) {
+    std::string result;
+    result.reserve(std::min<size_t>(value.size(), 80));
+    for (const unsigned char c : value) {
+        if (result.size() >= 80) {
+            break;
+        }
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+            (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.') {
+            result.push_back(static_cast<char>(c));
+        } else {
+            result.push_back('_');
+        }
+    }
+    return result.empty() ? fallback : result;
+}
+
+static uintmax_t reasoning_trace_limit(const char * name, uintmax_t default_value) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return default_value;
+    }
+    try {
+        return std::stoull(value);
+    } catch (...) {
+        return default_value;
+    }
+}
+
+static void prune_reasoning_traces(const std::filesystem::path & trace_dir) {
+    struct trace_file {
+        std::filesystem::file_time_type time;
+        std::filesystem::path json_path;
+        std::filesystem::path text_path;
+        uintmax_t bytes = 0;
+    };
+
+    const uintmax_t max_bytes = reasoning_trace_limit("LLAMA_REASONING_TRACE_MAX_BYTES", 512ull * 1024ull * 1024ull);
+    const uintmax_t max_files = reasoning_trace_limit("LLAMA_REASONING_TRACE_MAX_FILES", 2000);
+    std::vector<trace_file> files;
+    uintmax_t total_bytes = 0;
+    std::error_code ec;
+
+    for (const auto & entry : std::filesystem::directory_iterator(trace_dir, ec)) {
+        if (ec || !entry.is_regular_file(ec) || entry.path().extension() != ".json") {
+            continue;
+        }
+        const auto text_path = entry.path().parent_path() / (entry.path().stem().string() + ".txt");
+        const uintmax_t json_bytes = entry.file_size(ec);
+        const uintmax_t text_bytes = std::filesystem::is_regular_file(text_path, ec)
+            ? std::filesystem::file_size(text_path, ec) : 0;
+        trace_file item{entry.last_write_time(ec), entry.path(), text_path, json_bytes + text_bytes};
+        files.push_back(item);
+        total_bytes += item.bytes;
+    }
+
+    if (total_bytes <= max_bytes && files.size() <= max_files) {
+        return;
+    }
+
+    std::sort(files.begin(), files.end(), [](const trace_file & left, const trace_file & right) {
+        return left.time < right.time;
+    });
+    while (!files.empty() && (total_bytes > max_bytes || files.size() > max_files)) {
+        const trace_file file = files.front();
+        std::filesystem::remove(file.json_path, ec);
+        std::filesystem::remove(file.text_path, ec);
+        total_bytes = total_bytes > file.bytes ? total_bytes - file.bytes : 0;
+        files.erase(files.begin());
+    }
+}
