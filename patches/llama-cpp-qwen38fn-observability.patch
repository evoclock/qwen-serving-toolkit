+
+static json read_reasoning_trace_json(const std::filesystem::path & path) {
+    std::ifstream input(path);
+    const std::string contents{
+        std::istreambuf_iterator<char>(input),
+        std::istreambuf_iterator<char>{}};
+    return json::parse(contents);
+}
+
+static bool safe_trace_filename(const std::string & name) {
+    if (name.empty() || name.size() > 255 || name.find('/') != std::string::npos ||
+        name.find('\\') != std::string::npos || name == "." || name == "..") {
+        return false;
+    }
+    constexpr const char * suffix = ".json";
+    constexpr size_t suffix_size = 5;
+    return name.size() > suffix_size && name.compare(name.size() - suffix_size, suffix_size, suffix) == 0;
+}
+
+static server_http_res_ptr reasoning_traces_response(int status, const json & body) {
+    auto response = std::make_unique<server_http_res>();
+    response->status = status;
+    response->data = safe_json_to_str(body);
+    return response;
+}
+
+static server_http_context::handler_t make_reasoning_traces_handler() {
+    return [](const server_http_req & req) -> server_http_res_ptr {
+        const auto trace_dir = reasoning_trace_directory();
+        if (trace_dir.empty()) {
+            return reasoning_traces_response(404, {
+                {"error", {
+                    {"message", "reasoning traces are disabled"},
+                    {"type", "not_found"},
+                    {"code", 404},
+                }}
+            });
+        }
+
+        const std::string requested_file = req.get_param("id");
+        if (!requested_file.empty()) {
+            if (!safe_trace_filename(requested_file)) {
+                return reasoning_traces_response(400, {
+                    {"error", {
+                        {"message", "id must be a trace JSON filename"},
+                        {"type", "invalid_request"},
+                        {"code", 400},
+                    }}
+                });
+            }
+
+            const auto json_path = trace_dir / requested_file;
+            std::error_code ec;
+            if (!std::filesystem::is_regular_file(json_path, ec)) {
+                return reasoning_traces_response(404, {
+                    {"error", {
+                        {"message", "trace not found"},
+                        {"type", "not_found"},
+                        {"code", 404},
+                    }}
+                });
+            }
+
+            if (req.get_param("format") == "text") {
+                const auto text_path = json_path.parent_path() / (json_path.stem().string() + ".txt");
+                std::ifstream input(text_path);
+                if (!input) {
+                    return reasoning_traces_response(404, {
+                        {"error", {
+                            {"message", "trace text not found"},
+                            {"type", "not_found"},
+                            {"code", 404},
+                        }}
+                    });
+                }
+                auto response = std::make_unique<server_http_res>();
+                response->content_type = "text/plain; charset=utf-8";
+                response->data.assign(std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>());
+                return response;
+            }
+
+            try {
+                const json trace = read_reasoning_trace_json(json_path);
+                auto response = std::make_unique<server_http_res>();
+                response->data = safe_json_to_str(trace);
+                return response;
+            } catch (const std::exception & error) {
+                return reasoning_traces_response(500, {
+                    {"error", {
+                        {"message", string_format("cannot parse trace: %s", error.what())},
+                        {"type", "server_error"},
+                        {"code", 500},
+                    }}
+                });
+            }
+        }
+
+        std::vector<std::pair<std::filesystem::file_time_type, std::filesystem::path>> files;
+        std::error_code ec;
+        if (!std::filesystem::is_directory(trace_dir, ec)) {
+            return reasoning_traces_response(404, {
+                {"error", {
+                    {"message", "reasoning trace directory does not exist"},
+                    {"type", "not_found"},
+                    {"code", 404},
+                }}
+            });
+        }
+        for (const auto & entry : std::filesystem::directory_iterator(trace_dir, ec)) {
+            if (ec) {
+                break;
+            }
+            if (!entry.is_regular_file(ec) || entry.path().extension() != ".json") {
+                continue;
+            }
+            files.emplace_back(entry.last_write_time(ec), entry.path());
+        }
+        std::sort(files.begin(), files.end(), [](const auto & left, const auto & right) {
+            return left.first > right.first;
+        });
+
+        int limit = 20;
+        try {
+            limit = std::clamp(std::stoi(req.get_param("limit", "20")), 1, 100);
+        } catch (...) {
+            limit = 20;
+        }
+        const std::string session_id = req.get_param("session_id");
+        const std::string request_id = req.get_param("request_id");
+        json traces = json::array();
+        for (const auto & [_, path] : files) {
+            if (static_cast<int>(traces.size()) >= limit) {
+                break;
+            }
+            try {
+                const json trace = read_reasoning_trace_json(path);
+                const auto trace_session_id = trace.value("session_id", json(nullptr));
+                const auto trace_request_id = trace.value("request_id", json(nullptr));
+                if ((!session_id.empty() && (!trace_session_id.is_string() ||
+                     std::string(trace_session_id) != session_id)) ||
+                    (!request_id.empty() && (!trace_request_id.is_string() ||
+                     std::string(trace_request_id) != request_id))) {
+                    continue;
+                }
+                const auto budget = trace.value("reasoning_budget", json::object());
+                traces.push_back({
+                    {"id", path.filename().string()},
+                    {"timestamp_ms", json_value(trace, "timestamp_ms", int64_t(0))},
+                    {"task_id", json_value(trace, "task_id", int32_t(-1))},
+                    {"completion_id", trace.value("completion_id", std::string())},
+                    {"session_id", trace.value("session_id", json(nullptr))},
+                    {"request_id", trace.value("request_id", json(nullptr))},
+                    {"prompt_tokens", json_value(trace, "prompt_tokens", int32_t(0))},
+                    {"completion_tokens", json_value(trace, "completion_tokens", int32_t(0))},
+                    {"reasoning_budget", budget},
+                    {"text_available", std::filesystem::is_regular_file(
+                        path.parent_path() / (path.stem().string() + ".txt"), ec)},
+                });
+            } catch (...) {
+                // Ignore a concurrently written or malformed trace in a list response.
+            }
+        }
+
+        return reasoning_traces_response(200, {
+            {"traces", traces},
+            {"count", traces.size()},
+        });
+    };
+}
