+static void write_reasoning_trace(const server_task_result_cmpl_final & result, const json & response) {
+    static std::mutex trace_mutex;
+    std::lock_guard<std::mutex> lock(trace_mutex);
+    const char * trace_dir_env = std::getenv("LLAMA_REASONING_TRACE_DIR");
+    if (trace_dir_env == nullptr || *trace_dir_env == '\0') {
+        return;
+    }
+
+    try {
+        const std::filesystem::path trace_dir(trace_dir_env);
+        std::filesystem::create_directories(trace_dir);
+
+        const std::string session = trace_filename_component(result.generation_params.trace_session_id, "no-session");
+        const std::string completion = trace_filename_component(result.oaicompat_cmpl_id, "completion");
+        const std::string stem = string_format("%lld-task-%d-%s-%s",
+                static_cast<long long>(ggml_time_ms()), result.id, session.c_str(), completion.c_str());
+
+        const auto budget = reasoning_budget_to_json(result.reasoning_budget);
+        const std::string reasoning = result.oaicompat_msg.reasoning_content;
+        const std::string answer = result.oaicompat_msg.content;
+
+        const json trace = {
+            {"schema",                 1},
+            {"timestamp_ms",           ggml_time_ms()},
+            {"task_id",                result.id},
+            {"completion_id",          result.oaicompat_cmpl_id},
+            {"session_id",             result.generation_params.trace_session_id.empty()
+                                        ? json(nullptr) : json(result.generation_params.trace_session_id)},
+            {"request_id",             result.generation_params.trace_request_id.empty()
+                                        ? json(nullptr) : json(result.generation_params.trace_request_id)},
+            {"model",                  result.oaicompat_model},
+            {"prompt_tokens",          result.n_prompt_tokens},
+            {"prompt_cached_tokens",   result.n_prompt_tokens_cache},
+            {"completion_tokens",      result.n_decoded},
+            {"prompt",                 result.generation_params.trace_include_prompt
+                                        ? json(result.prompt) : json(nullptr)},
+            {"stop_type",              stop_type_to_str(result.stop)},
+            {"reasoning_budget",       budget},
+            {"reasoning_content",      reasoning},
+            {"content",                answer},
+            {"response",               response},
+        };
+
+        const auto json_path = trace_dir / (stem + ".json");
+        const auto json_tmp  = trace_dir / (stem + ".json.tmp");
+        {
+            std::ofstream out(json_tmp);
+            if (!out) {
+                throw std::runtime_error("cannot open reasoning trace JSON");
+            }
+            out << trace.dump(2) << '\n';
+        }
+        std::filesystem::rename(json_tmp, json_path);
+
+        const auto text_path = trace_dir / (stem + ".txt");
+        const auto text_tmp  = trace_dir / (stem + ".txt.tmp");
+        {
+            std::ofstream out(text_tmp);
+            if (!out) {
+                throw std::runtime_error("cannot open reasoning trace text");
+            }
+            out << "task_id: " << result.id << '\n'
+                << "session_id: " << (result.generation_params.trace_session_id.empty()
+                                        ? "(none)" : result.generation_params.trace_session_id) << '\n'
+                << "request_id: " << (result.generation_params.trace_request_id.empty()
+                                        ? "(none)" : result.generation_params.trace_request_id) << '\n'
+                << "prompt_tokens: " << result.n_prompt_tokens << '\n'
+                << "completion_tokens: " << result.n_decoded << '\n'
+                << "reasoning_budget: " << budget.dump() << "\n\n"
+                << "[reasoning]\n" << reasoning << "\n\n"
+                << "[answer]\n" << answer << '\n';
+        }
+        std::filesystem::rename(text_tmp, text_path);
+        prune_reasoning_traces(trace_dir);
+    } catch (const std::exception & error) {
+        LOG_WRN("reasoning trace write failed: %s\n", error.what());
+    }
+}
